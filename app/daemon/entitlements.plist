<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mở app từ daemon (SBSLaunchApplicationWithIdentifier) -->
	<key>com.apple.springboard.launchapplications</key>
	<true/>
	<key>com.apple.backboardd.launchapplications</key>
	<true/>
	<key>com.apple.frontboard.launchapplications</key>
	<true/>
	<!-- Chạy ngoài container để dùng LSApplicationProxy + killall -->
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<!-- clearAppData #1: xoá keychain của MỌI app. Wildcard "*" cho securityd cho phép
	     SecItem nhìn thấy item ở access-group của app khác (không có = chỉ thấy item của
	     chính daemon → xoá keychain thành no-op). Cùng cơ chế keychain_dumper dùng. -->
	<key>keychain-access-groups</key>
	<array>
		<string>*</string>
	</array>
	<!-- Truy vấn LaunchServices (liệt kê app, executableURL) -->
	<key>com.apple.lsapplicationworkspace.rw</key>
	<true/>
	<key>platform-application</key>
	<true/>
	<!-- HID EVENT DISPATCH (như TrollVNC): inject touch qua IOHIDEventSystemClientDispatchEvent -->
	<key>com.apple.private.hid.client.event-dispatch</key>
	<true/>
	<!-- CHỤP FRAMEBUFFER THẬT (như TrollVNC): mở IOMobileFramebuffer + IOSurfaceAccelerator -->
	<key>com.apple.private.IOSurface.protected-access</key>
	<true/>
	<key>com.apple.private.allow-explicit-graphics-priority</key>
	<true/>
	<key>com.apple.QuartzCore.global-capture</key>
	<true/>
	<key>com.apple.QuartzCore.secure-capture</key>
	<true/>
	<key>com.apple.security.iokit-user-client-class</key>
	<array>
		<string>IOMobileFramebufferUserClient</string>
		<string>IOSurfaceAcceleratorClient</string>
		<string>IOSurfaceRootUserClient</string>
		<string>IOAccelDevice</string>
		<string>IOAccelDevice2</string>
		<string>IOAccelContext</string>
		<string>IOAccelContext2</string>
		<string>IOAccelSharedUserClient</string>
		<string>IOAccelSharedUserClient2</string>
		<string>IOGPUDeviceUserClient</string>
		<string>AGXDevice</string>
		<string>AGXDeviceUserClient</string>
		<string>AGXSharedUserClient</string>
		<string>IOHIDEventSystemClient</string>
	</array>
</dict>
</plist>
