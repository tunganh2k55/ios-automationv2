<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.iosauto.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/local/iosauto/bin/iosautod</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/jb/var/log/iosautod.log</string>
	<key>StandardErrorPath</key>
	<string>/var/jb/var/log/iosautod.log</string>
</dict>
</plist>
