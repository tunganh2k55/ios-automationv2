# ===== Thanh toán: chuyển khoản QR (VietQR) + web2m webhook =====
# Tài khoản nhận tiền (dùng để sinh mã QR VietQR).
#   BANK_ID: mã ngân hàng theo VietQR — BIN (vd 970436 = Vietcombank) hoặc short code (VCB, TCB, MB...).
BANK_ID=970416
BANK_ACCOUNT=24489161
BANK_ACCOUNT_NAME=NGUYEN TUNG ANH
# Mẫu QR VietQR: compact2 (khuyên dùng) | compact | qr_only | print
BANK_QR_TEMPLATE=compact2

# Bí mật webhook web2m — đặt CHUỖI DÀI NGẪU NHIÊN. Cấu hình cùng giá trị này bên web2m.
# Link webhook khai báo cho web2m: https://<domain>/api/webhook/web2m?secret=<WEB2M_WEBHOOK_SECRET>
# (server cũng chấp nhận secret qua header X-Webhook-Secret hoặc Authorization.)
WEB2M_WEBHOOK_SECRET=cheat-duoc-thi-dung-free-32953294-sidaahihi

# Hạn thanh toán mỗi đơn (phút). Quá hạn chưa tới tiền → đơn tự chuyển 'expired'.
ORDER_TTL_MINUTES=15

# Cho phép endpoint mua GIẢ /api/purchase (cấp key ngay, KHÔNG thanh toán) — chỉ để test.
# Để trống ở production. =1 để bật.
ALLOW_MOCK_PURCHASE=

# ===== Nhóm 1: khóa ký GRANT Ed25519 (/api/grant) =====
# Seed private 32-byte (base64). Public key TƯƠNG ỨNG đã nhúng compile-time trong daemon (grant.m).
# ⚠️ Seed dưới đây do quá trình setup sinh ra — nếu muốn tuyệt đối bí mật, SINH LẠI bằng:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   rồi in public key mới:  node -e "require('dotenv').config(); console.log(require('./lib/grant').publicKeyRaw().toString('hex'))"
#   và cập nhật mảng GRANT_PUBKEY trong app/daemon/src/grant.m cho khớp.
GRANT_ED25519_SEED=SIQbdzbcR5rucrp5w5wudtMm9m2LFAMemmegMS0Ij9s=
# keyId để XOAY khóa sau này (daemon so khớp để chọn public key đúng).
GRANT_KEY_ID=license-2026-01
# TTL grant (phút) — mặc định 20.
GRANT_TTL_MINUTES=20
